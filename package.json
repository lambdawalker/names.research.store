{
  "name": "@lambdawalker/names-research-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "mcp": "node --env-file-if-exists=.env dist/mcp.js",
    "validate": "node dist/cli/validate.js",
    "summarize": "node dist/cli/summarize.js"
  },
  "dependencies": { "zod": "4.6.7", "@modelcontextprotocol/server": "2.4.0", "@modelcontextprotocol/client": "2.4.0", "neo4j-driver": "6.2.0", "turndown": "7.2.4" },
  "devDependencies": { "typescript": "7.0.2", "vitest": "5.0.5", "@types/node": "^24.0.0", "@types/turndown": "^5.0.0" }
}
